{
  "version": 2,
  "framework": "nextjs",
  "buildCommand": "cd voxguard-frontend && npm run build",
  "installCommand": "cd voxguard-frontend && npm install",
  "outputDirectory": "voxguard-frontend/.next",
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://YOUR_BACKEND_URL/api/:match*"
    }
  ]
}
