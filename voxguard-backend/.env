# VoxGuard Engine — Environment Configuration
# Copy to .env and fill in values for production

# ── Application ──
APP_NAME=VoxGuard Engine
DEBUG=true

# ── Detector ──
USE_ONNX=false
MODEL_PATH=
DETECTION_THRESHOLD=0.85

# ── Privacy ──
ENABLE_PII_MASKING=true
ZERO_RETENTION=true

# ── Auth ──
JWT_SECRET=voxguard-dev-secret-change-in-production

# ── Supabase (optional) ──
SUPABASE_URL=
SUPABASE_KEY=

# ── Redis (optional) ──
REDIS_URL=redis://localhost:6379/0

# ── Challenge Verification ──
USE_BACKEND_STT=true
WHISPER_MODEL_SIZE=tiny.en
